---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Bento from '../components/Bento.astro';
import Sticker from '../components/Sticker.astro';
import { site, topics, topicColor, heroVariants, url } from '../lib/site';
import foto from '../assets/mariana.jpg';

const all = await getCollection('artigos');
const published = all.filter((a) => !a.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const upcoming = all.filter((a) => a.data.draft);
const [featured, ...rest] = published;
const side = rest.slice(0, 2);
const more = rest.slice(2, 5);
const hero = heroVariants.a;
const words = hero.title.split(' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: `Dra. ${site.fullName}`,
  alternateName: site.nickname,
  medicalSpecialty: 'Pediatric',
  description: site.description,
  url: new URL(url('/'), Astro.site).toString(),
  image: new URL(url('/og-image.jpg'), Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: 'SP', addressCountry: 'BR' },
  identifier: [site.crm, site.rqe],
};

const badges = ['Pediatra', `Título de Especialista em Pediatria (SBP) · ${site.rqe}`, 'Certificação PALS (AHA)', 'Plantão em pronto atendimento', site.crm, site.rqe];

const faq = [
  ['A Tia Mari atende em consultório?', 'No momento, minha atuação é em pronto atendimento em Ribeirão Preto. As dicas são o jeito de levar essas explicações a mais famílias.'],
  ['Posso mandar uma dúvida sobre o meu filho?', 'As dicas são informativas e não substituem a avaliação do pediatra. Para o caso do seu filho, procure atendimento. Em sinais de alerta, vá a um pronto atendimento ou ligue 192 (SAMU).'],
  ['De onde vêm as informações?', 'De diretrizes da Sociedade Brasileira de Pediatria, de órgãos de saúde e de estudos revisados. As referências ficam no final de cada dica.'],
  ['Com que frequência saem dicas novas?', 'A ideia é publicar com regularidade. Quem se inscreve recebe cada dica nova por e-mail.'],
  ['Posso sugerir um tema?', 'Pode e deve! Use o campo de sugestão no formulário: muitas dicas nascem de perguntas de mães e pais.'],
];
---
<Base jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero" data-loop>
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="kicker hero-k"><Sticker kind="heart" size={26} /> Dicas da Tia Mari</p>
        <h1 class="hero-title" data-hero="title">
          {words.map((w, i) => <><span class="w" style={`--i: ${i}`}>{w}</span>{' '}</>)}
        </h1>
        <p class="hero-sub" data-hero="sub">{hero.sub}</p>
        <div class="hero-ctas">
          <a class="btn" href={url('/artigos/')} data-hero="cta">{hero.cta}</a>
          <a class="btn btn-white" href="#sobre">Conhecer a Tia Mari</a>
        </div>
        <p class="hero-badge"><span class="dot"></span>{site.role} · {site.crm} · {site.rqe}</p>
      </div>

      <div class="hero-art">
        <div class="blob-bg"></div>
        <div class="photo-wrap">
          <Image src={foto} alt="Dra. Mariana Rossi, a Tia Mari, sorrindo enquanto escreve no notebook" widths={[400, 575]} sizes="(max-width: 900px) 80vw, 440px" loading="eager" fetchpriority="high" class="photo" />
        </div>
        <Sticker kind="thermo" size={74} class="st st1" style="--rot: 14deg" />
        <Sticker kind="bandaid" size={70} class="st st2" style="--rot: -8deg" />
        <Sticker kind="star" size={58} class="st st3" style="--rot: 12deg" />
        <Sticker kind="drop" size={50} class="st st4" style="--rot: -10deg" />
        <a class="bento-spot" href="#brincar" aria-label="Oi, eu sou o Bento! Vamos brincar? Ir para os jogos">
          <Bento size={150} />
          <span class="bubble">Oi, eu sou o Bento!<br />Vamos brincar?</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LETREIRO DE SELOS -->
  <section class="marquee" aria-label="Credenciais" data-loop>
    <div class="marquee-track">
      {[0, 1].map((k) => (
        <ul aria-hidden={k === 1 ? 'true' : undefined}>
          {badges.map((b) => <li><Sticker kind="star" size={22} />{b}</li>)}
        </ul>
      ))}
    </div>
  </section>

  <!-- SEMÁFORO -->
  <section class="wrap sem" aria-labelledby="sem-t">
    <div class="sec-head pop">
      <p class="kicker">Semáforo da preocupação</p>
      <h2 id="sem-t" class="h2">Nem todo susto é urgência. Mas alguns são.</h2>
      <p class="lead">Um guia rápido pra você respirar e decidir o próximo passo.</p>
    </div>
    <div class="sem-grid">
      <article class="sem-card sem-g pop" style="--delay: 0s">
        <span class="sem-light" aria-hidden="true"></span>
        <h3>Observe em casa</h3>
        <ul>
          <li>Febre com a criança brincando e bebendo líquidos entre os picos</li>
          <li>Nariz escorrendo, sem cansaço para respirar</li>
          <li>Tombo leve, com choro que passa logo</li>
        </ul>
      </article>
      <article class="sem-card sem-y pop" style="--delay: .15s">
        <span class="sem-light" aria-hidden="true"></span>
        <h3>Converse com o pediatra</h3>
        <ul>
          <li>Tosse que não melhora depois de uma semana</li>
          <li>Dor de ouvido ou manchinhas na pele sem febre</li>
          <li>Criança comendo bem menos por vários dias</li>
        </ul>
      </article>
      <article class="sem-card sem-r pop" style="--delay: .3s">
        <span class="sem-light" aria-hidden="true"></span>
        <h3>Procure atendimento já</h3>
        <ul>
          <li>Dificuldade ou cansaço para respirar</li>
          <li>Bebê com menos de 3 meses com febre</li>
          <li>Criança muito sonolenta ou difícil de acordar</li>
          <li>Manchas roxas que não somem ao apertar</li>
        </ul>
      </article>
    </div>
    <p class="sem-note">Exemplos gerais, que não substituem a avaliação médica. Na dúvida, procure atendimento. Em emergência, ligue 192.</p>
  </section>

  <!-- BLOCOS ALTERNADOS -->
  <section class="feat t-ceu">
    <div class="wrap feat-inner">
      <div class="feat-art pop">
        <svg viewBox="0 0 320 240" class="ill ill-talk" aria-hidden="true">
          <g class="b1"><rect x="20" y="30" width="190" height="90" rx="28" fill="#fff" stroke="#3B2F45" stroke-width="4" /><path d="M60 118 L50 148 L88 118 Z" fill="#fff" stroke="#3B2F45" stroke-width="4" stroke-linejoin="round" /><rect x="48" y="62" width="120" height="12" rx="6" fill="#4FB6F0" /><rect x="48" y="84" width="80" height="12" rx="6" fill="#DDF1FF" /></g>
          <g class="b2"><rect x="120" y="128" width="180" height="80" rx="28" fill="#1478BC" stroke="#3B2F45" stroke-width="4" /><path d="M260 206 L272 232 L236 206 Z" fill="#1478BC" stroke="#3B2F45" stroke-width="4" stroke-linejoin="round" /><circle cx="176" cy="168" r="9" fill="#fff" /><circle cx="210" cy="168" r="9" fill="#fff" /><circle cx="244" cy="168" r="9" fill="#fff" /></g>
        </svg>
      </div>
      <div class="feat-copy pop" style="--delay: .1s">
        <p class="kicker" style="color: var(--ceu);">Do jeitinho do plantão</p>
        <h2 class="h2">Explicado como se eu estivesse do seu lado.</h2>
        <p class="lead">Sem palavra difícil e sem julgamento. Cada dica traduz o termo técnico e usa exemplos de casa, do dia a dia com as crianças.</p>
      </div>
    </div>
  </section>

  <section class="feat feat-rev t-uva">
    <div class="wrap feat-inner">
      <div class="feat-art pop">
        <svg viewBox="0 0 320 240" class="ill ill-book" aria-hidden="true">
          <path d="M40 70 Q100 50 160 76 L160 206 Q100 180 40 200 Z" fill="#fff" stroke="#3B2F45" stroke-width="4" stroke-linejoin="round" />
          <path d="M280 70 Q220 50 160 76 L160 206 Q220 180 280 200 Z" fill="#EEE8FF" stroke="#3B2F45" stroke-width="4" stroke-linejoin="round" />
          <path d="M64 100 Q100 92 136 104 M64 124 Q100 116 136 128 M64 148 Q100 140 136 152" stroke="#7C5CE0" stroke-width="6" stroke-linecap="round" fill="none" />
          <path d="M190 130 l14 14 l28 -30" stroke="#0B8577" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none" class="check" />
          <path class="spin s1" d="M70 20 L75 32 L88 33 L78 41 L81 54 L70 47 L59 54 L62 41 L52 33 L65 32 Z" fill="#FFC845" stroke="#3B2F45" stroke-width="3" stroke-linejoin="round" />
          <path class="spin s2" d="M250 14 L254 24 L265 25 L257 32 L259 43 L250 37 L241 43 L243 32 L235 25 L246 24 Z" fill="#FFC845" stroke="#3B2F45" stroke-width="3" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="feat-copy pop" style="--delay: .1s">
        <p class="kicker" style="color: var(--uva);">Baseado em evidência</p>
        <h2 class="h2">Carinho no jeito, ciência no conteúdo.</h2>
        <p class="lead">Cada dica parte das recomendações da Sociedade Brasileira de Pediatria e de estudos atuais, com as referências no final para você conferir.</p>
      </div>
    </div>
  </section>

  <section class="feat t-menta">
    <div class="wrap feat-inner">
      <div class="feat-art pop">
        <svg viewBox="0 0 320 240" class="ill ill-thermo" aria-hidden="true">
          <rect x="138" y="20" width="44" height="150" rx="22" fill="#fff" stroke="#3B2F45" stroke-width="4" />
          <rect class="merc" x="150" y="60" width="20" height="110" rx="10" fill="#D63A63" />
          <circle cx="160" cy="186" r="32" fill="#D63A63" stroke="#3B2F45" stroke-width="4" />
          <path d="M190 52h16M190 80h16M190 108h16M190 136h16" stroke="#3B2F45" stroke-width="4" stroke-linecap="round" />
          <g class="pulse"><circle cx="72" cy="90" r="34" fill="#DDF7F3" stroke="#0B8577" stroke-width="4" /><path d="M56 90h10l6-12 8 24 6-12h10" stroke="#0B8577" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
          <g class="pulse p2"><circle cx="250" cy="170" r="28" fill="#FFF4D1" stroke="#E0A12A" stroke-width="4" /><path d="M250 156v16M250 182v1" stroke="#3B2F45" stroke-width="6" stroke-linecap="round" /></g>
        </svg>
      </div>
      <div class="feat-copy pop" style="--delay: .1s">
        <p class="kicker" style="color: var(--menta);">Sinais de alerta à vista</p>
        <h2 class="h2">Toda dica termina dizendo quando procurar ajuda.</h2>
        <p class="lead">Informação boa acalma, mas não substitui consulta. Por isso os sinais que pedem atendimento ficam sempre destacados, sem precisar procurar.</p>
      </div>
    </div>
  </section>

  <!-- DICAS -->
  <section id="dicas" class="wrap dicas" aria-labelledby="dicas-t">
    <div class="sec-head pop" style="text-align: left; align-items: flex-start; margin: 0;">
      <p class="kicker">Dicas da Tia Mari</p>
      <h2 id="dicas-t" class="h2">O que eu explico toda semana, agora por escrito.</h2>
    </div>
    <nav class="chips pop" aria-label="Temas">
      {topics.map((t) => <a class={`chip ${topicColor[t]}`} href={url(`/artigos/?tema=${encodeURIComponent(t)}`)}>{t}</a>)}
    </nav>
    {featured && (
      <div class="dicas-grid">
        <div class="dicas-main"><ArticleCard entry={featured} feature /></div>
        {side.length > 0 && <div class="dicas-side">{side.map((a, i) => <ArticleCard entry={a} delay={0.1 * (i + 1)} />)}</div>}
      </div>
    )}
    {more.length > 0 && <div class="grid-cards">{more.map((a, i) => <ArticleCard entry={a} delay={0.08 * i} />)}</div>}
    {upcoming.length > 0 && (
      <div class="soon pop">
        <p style="font-family: var(--display); font-weight: 600; font-size: 20px;">Em breve por aqui</p>
        <ul>
          {upcoming.map((a) => <li class={topicColor[a.data.topic]}>{a.data.title}</li>)}
        </ul>
      </div>
    )}
    <a class="btn btn-white pop" href={url('/artigos/')} style="align-self: center;">Ver todas as dicas</a>
  </section>

  <!-- BRINQUE COM O BENTO -->
  <section id="brincar" class="brincar" aria-labelledby="brincar-t" data-loop>
    <div class="wrap brincar-inner">
      <div class="brincar-head pop">
        <Bento size={130} />
        <div>
          <p class="kicker" style="color: var(--ink);">Hora do intervalo</p>
          <h2 id="brincar-t" class="h2">Brinque com o Bento</h2>
          <p class="lead" style="color: var(--ink);">Seis joguinhos simples para a criança se divertir, de preferência com você do lado.</p>
        </div>
      </div>
      <div class="games">
        <a class="game t-morango pop" href={url('/jogos/jogo-da-velha/')} style="--delay: 0s">
          <div class="game-art" aria-hidden="true">
            <div class="mini-board">
              {['heart','','star','','heart','','star','','heart'].map((k) => <span>{k && <Sticker kind={k as any} size={30} />}</span>)}
            </div>
          </div>
          <span class="tag">2 jogadores · você e o Bento</span>
          <h3 class="card-title">Jogo da velha</h3>
          <p>Coração contra estrela. Faça uma linha de três antes do Bento!</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
        <a class="game t-uva pop" href={url('/jogos/jogo-da-memoria/')} style="--delay: .12s">
          <div class="game-art" aria-hidden="true">
            <div class="mini-cards">
              <span class="mc mc1"><Sticker kind="thermo" size={40} /></span>
              <span class="mc mc2 down"></span>
              <span class="mc mc3"><Sticker kind="thermo" size={40} /></span>
            </div>
          </div>
          <span class="tag">A partir de 3 anos</span>
          <h3 class="card-title">Jogo da memória</h3>
          <p>Vire as cartas e encontre os pares de figurinhas.</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
        <a class="game t-ceu pop" href={url('/jogos/estoura-bolhas/')} style="--delay: .24s">
          <div class="game-art" aria-hidden="true">
            <span class="bb b1"></span><span class="bb b2"></span><span class="bb b3"></span><span class="bb b4"></span>
          </div>
          <span class="tag">Para os pequenos</span>
          <h3 class="card-title">Estoura bolhas</h3>
          <p>É só tocar nas bolhas coloridas antes que elas voem embora.</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
        <a class="game t-menta pop" href={url('/jogos/escove-os-dentes/')} style="--delay: 0s">
          <div class="game-art" aria-hidden="true">
            <div class="mini-teeth">
              <span></span><span class="g"></span><span></span><span class="g"></span>
            </div>
          </div>
          <span class="tag">Hora da escovação</span>
          <h3 class="card-title">Escove os dentes do Bento</h3>
          <p>Toque nos bichinhos da cárie e deixe o sorriso dele brilhando.</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
        <a class="game t-sol pop" href={url('/jogos/esconde-esconde/')} style="--delay: .12s">
          <div class="game-art" aria-hidden="true">
            <div class="mini-bushes"><span></span><span class="ears"></span><span></span></div>
          </div>
          <span class="tag">Para os pequenos</span>
          <h3 class="card-title">Esconde-esconde</h3>
          <p>O Bento se escondeu atrás de um arbusto. Será que você acha?</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
        <a class="game t-uva pop" href={url('/jogos/siga-o-bento/')} style="--delay: .24s">
          <div class="game-art" aria-hidden="true">
            <div class="mini-pads">
              <span style="--pc: #FF8FAB"><Sticker kind="heart" size={30} /></span>
              <span style="--pc: #FFD76A" class="on"><Sticker kind="star" size={30} /></span>
              <span style="--pc: #8FD3FF"><Sticker kind="drop" size={30} /></span>
              <span style="--pc: #B9A6F5"><Sticker kind="bandaid" size={30} /></span>
            </div>
          </div>
          <span class="tag">A partir de 4 anos</span>
          <h3 class="card-title">Siga o Bento</h3>
          <p>Observe a sequência de cores e sons e repita na mesma ordem.</p>
          <span class="game-cta">Jogar <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="sobre" aria-labelledby="sobre-t">
    <div class="wrap sobre-inner">
      <div class="sobre-photo pop">
        <Image src={foto} alt="" widths={[360, 520]} sizes="(max-width: 900px) 70vw, 380px" class="sobre-img" />
        <Sticker kind="heart" size={64} class="float sobre-st" style="--rot: -10deg" />
      </div>
      <div class="sobre-copy pop" style="--delay: .1s">
        <p class="kicker" style="color: #fff;">Quem é a Tia Mari</p>
        <h2 id="sobre-t" class="h2">Prazer, sou a Mariana. Mas pode me chamar de Tia Mari.</h2>
        <p>Sou {site.fullName}, pediatra em Ribeirão Preto, com Título de Especialista em Pediatria pela Sociedade Brasileira de Pediatria ({site.rqe}) e certificação em suporte avançado de vida pediátrico (PALS).</p>
        <p>No plantão, boa parte do meu trabalho é explicar para mães e pais o que está acontecendo, o que esperar e quando voltar. Percebi que essas explicações ajudam muito além do atendimento, então resolvi escrevê-las aqui, com calma e carinho.</p>
        <blockquote>“Pai e mãe informados ficam mais tranquilos, e criança se cuida melhor com família tranquila.”</blockquote>
      </div>
    </div>
  </section>

  <!-- FORMAÇÃO -->
  <section id="formacao" class="wrap formacao" aria-labelledby="formacao-t">
    <div class="sec-head pop">
      <p class="kicker">Formação</p>
      <h2 id="formacao-t" class="h2">Preparo de quem cuida de criança todo dia.</h2>
    </div>
    <div class="medals">
      <div class="medal pop t-morango" style="--delay: 0s">
        <span class="medal-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="18" r="10" fill="none" stroke="currentColor" stroke-width="4" /><path d="M16 26l-4 16 12-6 12 6-4-16" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /></svg></span>
        <h3>Título de Especialista em Pediatria</h3>
        <p>Sociedade Brasileira de Pediatria (SBP) · {site.rqe}</p>
      </div>
      <div class="medal pop t-ceu" style="--delay: .12s">
        <span class="medal-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 42 C 8 32, 4 20, 12 13 C 17 9, 22 11, 24 15 C 26 11, 31 9, 36 13 C 44 20, 40 32, 24 42 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path d="M12 25h7l3-5 4 9 3-4h7" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <h3>Certificação PALS</h3>
        <p>Pediatric Advanced Life Support · American Heart Association (AHA)</p>
      </div>
      <div class="medal pop t-uva" style="--delay: .24s">
        <span class="medal-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="4" /><path d="M24 14v10l7 5" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <h3>Plantão em pronto atendimento</h3>
        <p>Urgências pediátricas em Ribeirão Preto, no dia a dia</p>
      </div>
    </div>
  </section>

  <!-- DÚVIDAS -->
  <section id="duvidas" class="duvidas" aria-labelledby="duvidas-t">
    <div class="duv-inner">
      <div class="sec-head pop">
        <p class="kicker">Dúvidas dos pais</p>
        <h2 id="duvidas-t" class="h2">Perguntas que sempre aparecem</h2>
      </div>
      <div class="faq pop">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
</Base>

<script>
  // Teste A/B do hero: ?v=b ou ?v=c troca o texto.
  import { heroVariants } from '../lib/site';
  const v = new URLSearchParams(location.search).get('v')?.toLowerCase();
  if (v === 'b' || v === 'c') {
    const h = heroVariants[v];
    const set = (k: string, t: string) => { const el = document.querySelector(`[data-hero="${k}"]`); if (el) el.textContent = t; };
    set('title', h.title); set('sub', h.sub); set('cta', h.cta);
  }
</script>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, #fff 0%, var(--cream) 100%); }
  .hero-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding-top: 56px; padding-bottom: 72px; }
  .hero-text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .hero-k { font-size: 20px; }
  .hero-title { font-size: clamp(3rem, 6.6vw, 5.6rem); line-height: 0.98; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; }
  .hero-sub { font-size: 21px; line-height: 1.55; color: var(--muted); max-width: 560px; font-weight: 600; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px; }
  .hero-badge { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 15px; color: var(--ink); background: var(--menta-l); padding: 8px 16px; border-radius: 999px; align-self: flex-start; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--menta); box-shadow: 0 0 0 4px rgba(11,133,119,.18); }
  .hero-art { flex: 1 1 360px; min-width: 0; position: relative; max-width: 450px; margin: 0 auto; padding: 24px 24px 40px; }
