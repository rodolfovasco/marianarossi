---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { site, topics, heroVariants, url } from '../lib/site';
import foto from '../assets/mariana.jpg';

const all = await getCollection('artigos');
const published = all.filter((a) => !a.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const upcoming = all.filter((a) => a.data.draft);
const [featured, ...rest] = published;
const side = rest.slice(0, 2);
const more = rest.slice(2, 5);
const hero = heroVariants.a;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: `Dra. ${site.fullName}`,
  description: site.description,
  url: new URL(url('/'), Astro.site).toString(),
  image: new URL(url('/og-image.jpg'), Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: 'SP', addressCountry: 'BR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Centro Universitário Barão de Mauá' },
  identifier: site.crm,
};

const faq = [
  ['A Dra. Mariana atende em consultório?', 'No momento, minha atuação é em pronto atendimento em Ribeirão Preto. Os artigos são a forma de levar essas explicações a mais gente.'],
  ['Posso tirar uma dúvida sobre o meu caso por mensagem?', 'Os artigos são informativos e não substituem uma avaliação presencial. Para o seu caso, procure atendimento. Em sinais de alerta, vá a um pronto atendimento ou ligue 192 (SAMU).'],
  ['De onde vêm as informações dos artigos?', 'De diretrizes de sociedades médicas, órgãos de saúde e estudos revisados. As referências ficam no final de cada texto.'],
  ['Com que frequência saem artigos novos?', 'A ideia é publicar com regularidade. Quem se inscreve recebe cada artigo novo por e-mail.'],
  ['Posso sugerir um tema?', 'Pode, sim. Use o campo de sugestão no formulário abaixo: muitas pautas nascem de perguntas de leitores.'],
];
---
<Base jsonLd={jsonLd}>
  <!-- HERO -->
  <section id="topo" class="wrap hero">
    <div class="hero-text hero-in">
      <p class="eyebrow">Dra. Mariana Rossi · Médica em Ribeirão Preto</p>
      <h1 class="hero-title" data-hero="title">{hero.title}</h1>
      <p class="hero-sub" data-hero="sub">{hero.sub}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px;">
        <a class="btn btn-primary" href={url('/artigos/')} data-hero="cta" data-event="cta_hero_click">{hero.cta}</a>
        <a class="btn btn-ghost" href="#sobre">Conhecer a Dra. Mariana</a>
      </div>
      <ul class="proof">
        <li><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{site.crm}</li>
        <li><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/></svg>Formada pela Barão de Mauá</li>
        <li><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-7 4 14 3-7h4"/></svg>Rotina de pronto atendimento</li>
      </ul>
    </div>
    <div class="hero-media">
      <Image src={foto} alt="Dra. Mariana Rossi sorrindo enquanto escreve no notebook, em um escritório claro com plantas" widths={[420, 640, 940]} sizes="(max-width: 900px) 92vw, 470px" loading="eager" fetchpriority="high" class="hero-img" />
      {featured && (
        <a class="hero-card" href={url(`/artigos/${featured.id}/`)}>
          <span class="eyebrow" style="font-size: 12px;">Artigo mais recente</span>
          <span class="card-title" style="font-size: 18px;">{featured.data.title}</span>
          <span class="card-meta">Ler agora <span class="arrow">→</span></span>
        </a>
      )}
    </div>
  </section>

  <!-- COMO EU ESCREVO -->
  <section aria-labelledby="metodo-t" style="background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="wrap reveal" style="padding-top: 88px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 48px;">
      <div style="display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: end; justify-content: space-between;">
        <h2 id="metodo-t" class="h2" style="flex: 1 1 420px;">Informação médica que você consegue usar.</h2>
        <p class="lead" style="flex: 1 1 380px;">No plantão, a pergunta que mais escuto não é “o que eu tenho?”, e sim “isso é grave?”. Cada texto aqui foi escrito para responder essa pergunta com calma e precisão.</p>
      </div>
      <div class="grid-cards">
        {[
          ['01', 'Baseado em evidências', 'Cada artigo parte de diretrizes e estudos atuais, com as referências listadas no final do texto.'],
          ['02', 'Na linguagem do consultório', 'Explico como explicaria pessoalmente: termos técnicos traduzidos e exemplos do dia a dia.'],
          ['03', 'Com sinais de alerta claros', 'Informação não substitui consulta. Todo texto termina dizendo quando é hora de procurar atendimento.'],
        ].map(([n, t, d]) => (
          <div style="background: var(--bg); border-radius: var(--radius); padding: 32px; display: flex; flex-direction: column; gap: 12px;">
            <span style="font-family: var(--display); font-size: 15px; font-weight: 600; color: var(--accent);">{n}</span>
            <h3 style="font-size: 23px; line-height: 1.2;">{t}</h3>
            <p style="color: var(--muted);">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ARTIGOS -->
  <section id="artigos" aria-labelledby="artigos-t" class="wrap reveal" style="padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 40px;">
    <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: end; justify-content: space-between;">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <p class="eyebrow">Artigos</p>
        <h2 id="artigos-t" class="h2">O que eu explico toda semana, por escrito.</h2>
      </div>
      <a href={url('/artigos/')} style="font-weight: 600; text-decoration: none; padding: 10px 0;">Ver todos os artigos →</a>
    </div>
    <nav class="chips" aria-label="Temas">
      {topics.map((t) => <a class="chip" href={url(`/artigos/?tema=${encodeURIComponent(t)}`)}>{t}</a>)}
    </nav>
    {featured && (
      <div style="display: flex; flex-wrap: wrap; gap: 24px;">
        <div style="flex: 2 1 520px; min-width: 0; display: flex;"><ArticleCard entry={featured} feature /></div>
        {side.length > 0 && (
          <div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 24px;">
            {side.map((a) => <ArticleCard entry={a} />)}
          </div>
        )}
      </div>
    )}
    {more.length > 0 && <div class="grid-cards">{more.map((a) => <ArticleCard entry={a} />)}</div>}
    {upcoming.length > 0 && (
      <div style="border-top: 1px solid var(--line); padding-top: 28px; display: flex; flex-direction: column; gap: 14px;">
        <p style="font-weight: 600;">Em breve por aqui</p>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px;">
          {upcoming.map((a) => (
            <li style="background: var(--soft); border-radius: 999px; padding: 8px 16px; font-size: 15px; color: var(--ink-2);">{a.data.title}</li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <!-- SOBRE -->
  <section id="sobre" aria-labelledby="sobre-t" style="background: var(--soft);">
    <div class="wrap reveal" style="padding-top: 96px; padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start;">
      <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 20px;">
        <p class="eyebrow">Sobre</p>
        <h2 id="sobre-t" class="h2">Prazer, sou a Mariana.</h2>
        <blockquote style="margin: 12px 0 0; font-family: var(--display); font-size: 24px; line-height: 1.35; font-weight: 500; color: var(--accent);">“Uma boa explicação muda a forma como a pessoa sai do atendimento. Eu quero que ela chegue a mais gente.”</blockquote>
      </div>
      <div style="flex: 1.4 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px; font-size: 18px; color: var(--ink-2);">
        <p>Sou {site.fullName}, médica formada em 2013 pelo Centro Universitário Barão de Mauá, em Ribeirão Preto. Hoje atuo em plantões de pronto atendimento na cidade, onde boa parte do trabalho é explicar: o que está acontecendo, o que esperar nos próximos dias e quando voltar.</p>
        <p>Percebi que essas explicações ajudam muito além da consulta. Por isso criei este espaço: para escrever, com calma e base científica, as respostas que as pessoas mais precisam e nem sempre têm tempo de ouvir no corredor de um plantão.</p>
        <dl class="facts">
          <div><dt>Registro</dt><dd>{site.crm}</dd></div>
          <div><dt>Graduação</dt><dd>Medicina · Barão de Mauá · 2013</dd></div>
          <div><dt>Atuação</dt><dd>Pronto atendimento · Ribeirão Preto</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FORMAÇÃO -->
  <section id="formacao" aria-labelledby="formacao-t" class="wrap reveal" style="padding-top: 96px; padding-bottom: 96px; display: flex; flex-wrap: wrap; gap: 56px;">
    <div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 16px;">
      <p class="eyebrow">Formação e atualização</p>
      <h2 id="formacao-t" class="h2">Estudo contínuo, porque a medicina muda.</h2>
      <p class="lead">Títulos e certificações que sustentam cada explicação.</p>
    </div>
    <ol class="cv">
      <li><span class="cv-t">Médica pediatra · Título de Especialista em Pediatria</span><span class="cv-d">Sociedade Brasileira de Pediatria (SBP)</span></li>
      <li><span class="cv-t">Certificação PALS — Pediatric Advanced Life Support</span><span class="cv-d">American Heart Association (AHA)</span></li>
      <li><span class="cv-t">Graduação em Medicina</span><span class="cv-d">Centro Universitário Barão de Mauá · 2013</span></li>
    </ol>
  </section>

  <!-- DÚVIDAS -->
  <section id="duvidas" aria-labelledby="duvidas-t" style="background: var(--surface); border-top: 1px solid var(--line);">
    <div class="reveal" style="max-width: 880px; margin: 0 auto; padding: 96px 24px; display: flex; flex-direction: column; gap: 32px;">
      <h2 id="duvidas-t" class="h2">Dúvidas frequentes</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
</Base>

<script>
  // Teste A/B do hero: ?v=b ou ?v=c troca o texto.
  import { heroVariants } from '../lib/site';
  const v = new URLSearchParams(location.search).get('v')?.toLowerCase();
  if (v === 'b' || v === 'c') {
    const h = heroVariants[v];
    const set = (k: string, t: string) => { const el = document.querySelector(`[data-hero="${k}"]`); if (el) el.textContent = t; };
    set('title', h.title); set('sub', h.sub); set('cta', h.cta);
  }
</script>

<style>
  .hero { padding-top: 64px; padding-bottom: 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .hero-text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero-title { font-size: clamp(2.3rem, 4.4vw, 4rem); line-height: 1.05; letter-spacing: -0.025em; }
  .hero-sub { font-size: 20px; line-height: 1.55; color: var(--muted); max-width: 560px; }
  .proof { list-style: none; margin: 8px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 15px; color: var(--muted); }
  .proof li { display: flex; align-items: center; gap: 8px; }
  .proof svg { color: var(--accent); flex: none; }
  .hero-media { flex: 1 1 360px; min-width: 0; max-width: 470px; margin: 0 auto; position: relative; }
  .hero-img { width: 100%; aspect-ratio: 575 / 950; object-fit: cover; object-position: 50% 100%; border-radius: 28px; }
  .hero-card { position: absolute; right: -28px; top: 28px; max-width: 260px; background: #fff; color: var(--ink); text-decoration: none; border-radius: 18px; padding: 18px 20px; box-shadow: 0 18px 40px rgba(43, 27, 33, 0.14); display: flex; flex-direction: column; gap: 6px; transition: transform .18s var(--ease); }
  .hero-card:hover { color: var(--ink); transform: translateY(-2px); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-card { opacity: 0; animation: rise .4s var(--ease) .3s forwards; transform: translateY(8px); }
  }
  @media (max-width: 900px) {
    .hero { padding-top: 40px; gap: 40px; }
    .hero-card { position: static; max-width: none; margin-top: 16px; }
  }
  .facts { margin: 12px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .facts div { background: #fff; border-radius: 18px; padding: 20px 22px; }
  .facts dt { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-2); }
  .facts dd { margin: 4px 0 0; font-weight: 600; color: var(--ink); }
  .cv { flex: 1.4 1 460px; min-width: 0; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .cv li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; padding: 22px 0; border-top: 1px solid var(--line); }
  .cv li:last-child { border-bottom: 1px solid var(--line); }
  .cv-t { font-weight: 600; }
  .cv-d { color: var(--muted-2); }
  .faq { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); padding: 22px 0; }
  .faq summary { font-weight: 600; font-size: 19px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; min-height: 44px; align-items: center; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--display); font-size: 26px; color: var(--accent); transition: transform .2s var(--ease); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin-top: 12px; color: var(--muted); }
</style>
