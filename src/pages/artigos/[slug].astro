---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site, url, readingMinutes, formatDate } from '../../lib/site';
import avatar from '../../assets/avatar.jpg';

export async function getStaticPaths() {
  const all = await getCollection('artigos');
  return all.filter((a) => !a.data.draft).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const minutes = readingMinutes(entry.body ?? '');
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${d.title} — ${pageUrl}`)}`;

const others = (await getCollection('artigos'))
  .filter((a) => !a.data.draft && a.id !== entry.id)
  .sort((a, b) => Number(b.data.topic === d.topic) - Number(a.data.topic === d.topic) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: d.title,
  description: d.description,
  url: pageUrl,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'pt-BR',
  author: { '@type': 'Physician', name: `Dra. ${site.fullName}`, identifier: site.crm },
  reviewedBy: { '@type': 'Physician', name: `Dra. ${site.fullName}` },
};
---
<Base title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <article class="article">
    <nav aria-label="Você está em" class="crumbs"><a href={url('/artigos/')}>Artigos</a> / {d.topic}</nav>
    <h1 class="a-title">{d.title}</h1>
    <p class="a-lead">{d.description}</p>
    <div class="a-meta">
      <span style="font-weight: 600; color: var(--ink);">Por Dra. Mariana Rossi · {site.crm}</span>
      <span>{minutes} min de leitura</span>
      <span>{d.updated ? `Atualizado em ${formatDate(d.updated)}` : `Publicado em ${formatDate(d.date)}`}</span>
    </div>

    {d.summary.length > 0 && (
      <aside class="a-summary" aria-label="Resumo">
        <p class="eyebrow">Resumo em 30 segundos</p>
        <ul>{d.summary.map((s) => <li>{s}</li>)}</ul>
      </aside>
    )}

    <div class="prose">
      <Content />
    </div>

    {d.alerts.length > 0 && (
      <section class="a-alert" aria-labelledby="alerta-t">
        <h2 id="alerta-t">Procure atendimento no mesmo dia se houver</h2>
        <ul>{d.alerts.map((s) => <li>{s}</li>)}</ul>
        <p>Em emergência, ligue 192 (SAMU).</p>
      </section>
    )}

    <div class="a-share">
      <a class="btn btn-ghost btn-sm" href={whatsapp} target="_blank" rel="noopener" data-event="whatsapp_share">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg>
        Enviar pelo WhatsApp
      </a>
    </div>

    <div class="a-refs">
      {d.references.length > 0 && (
        <>
          <p style="font-weight: 600; color: var(--ink);">Referências</p>
          <ol>
            {d.references.map((r) => <li>{r.url ? <a href={r.url} rel="noopener" target="_blank">{r.label}</a> : r.label}</li>)}
          </ol>
        </>
      )}
      <p>Este conteúdo é informativo e não substitui uma consulta médica.</p>
    </div>

    <div class="a-author">
      <Image src={avatar} alt="" width={152} height={152} class="a-avatar" />
      <div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 4px;">
        <span style="font-weight: 600;">Dra. {site.fullName} · {site.crm}</span>
        <span style="font-size: 16px; color: var(--muted); line-height: 1.5;">Médica formada pela Barão de Mauá, atua em pronto atendimento em Ribeirão Preto e escreve para explicar com clareza o que ouve todos os dias.</span>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="wrap" aria-labelledby="mais-t" style="padding-top: 48px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 24px;">
      <h2 id="mais-t" style="font-size: 28px;">Continue lendo</h2>
      <div class="grid-cards">{others.map((a) => <ArticleCard entry={a} />)}</div>
    </section>
  )}

  <Newsletter title="Quer receber o próximo artigo?" text="Uma explicação por vez, direto no seu e-mail." />
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const art = document.querySelector<HTMLElement>('.article');
  if (bar && art) {
    const update = () => {
      const r = art.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 30; }
  .progress span { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  .article { max-width: 760px; margin: 0 auto; padding: 56px 24px 32px; display: flex; flex-direction: column; gap: 22px; font-size: 18px; line-height: 1.7; }
  .crumbs { font-size: 14px; color: var(--muted-2); }
  .crumbs a { color: var(--muted-2); }
  .a-title { font-size: clamp(2.1rem, 4vw, 3.4rem); line-height: 1.08; view-transition-name: article-title; }
  .a-lead { font-size: 21px; color: var(--muted); line-height: 1.55; }
  .a-meta { display: flex; flex-wrap: wrap; gap: 10px 20px; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 15px; color: var(--muted-2); }
  .a-summary { background: var(--soft); border-radius: 20px; padding: 26px 28px; display: flex; flex-direction: column; gap: 10px; }
  .a-summary ul, .a-alert ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .prose :global(h2) { font-size: 30px; line-height: 1.2; margin: 36px 0 12px; letter-spacing: -0.01em; }
  .prose :global(h3) { font-size: 23px; line-height: 1.25; margin: 28px 0 10px; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; padding-left: 22px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(blockquote) { margin: 24px 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--accent); color: var(--ink-2); font-style: italic; }
  .a-alert { background: var(--ink); color: #fff; border-radius: 22px; padding: 30px 30px 26px; display: flex; flex-direction: column; gap: 12px; }
  .a-alert h2 { font-size: 26px; line-height: 1.2; }
  .a-alert ul { color: #F1E4E6; }
  .a-alert p { font-size: 15px; color: var(--on-dark); }
  .a-share { display: flex; }
  .a-refs { padding-top: 20px; border-top: 1px solid var(--line); font-size: 15px; color: var(--muted-2); display: flex; flex-direction: column; gap: 8px; }
  .a-refs ol { margin: 0; padding-left: 20px; }
  .a-author { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  .a-avatar { width: 76px; height: 76px; border-radius: 999px; object-fit: cover; }
</style>
