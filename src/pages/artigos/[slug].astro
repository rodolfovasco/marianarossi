---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site, url, readingMinutes, formatDate, topicColor } from '../../lib/site';
import avatar from '../../assets/avatar.jpg';

export async function getStaticPaths() {
  const all = await getCollection('artigos');
  return all.filter((a) => !a.data.draft).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const minutes = readingMinutes(entry.body ?? '');
const color = topicColor[d.topic] ?? 't-morango';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${d.title} — ${pageUrl}`)}`;

const others = (await getCollection('artigos'))
  .filter((a) => !a.data.draft && a.id !== entry.id)
  .sort((a, b) => Number(b.data.topic === d.topic) - Number(a.data.topic === d.topic) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: d.title,
  description: d.description,
  url: pageUrl,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'pt-BR',
  author: { '@type': 'Physician', name: `Dra. ${site.fullName}`, identifier: [site.crm, site.rqe], medicalSpecialty: 'Pediatric' },
  reviewedBy: { '@type': 'Physician', name: `Dra. ${site.fullName}` },
};
---
<Base title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <header class={`a-head ${color}`}>
    <div class="a-head-inner">
      <nav aria-label="Você está em" class="crumbs"><a href={url('/artigos/')}>Dicas da Tia Mari</a> / {d.topic}</nav>
      <span class="tag">{d.topic}</span>
      <h1 class="a-title">{d.title}</h1>
      <p class="a-lead">{d.description}</p>
      <div class="a-meta">
        <span style="font-weight: 800; color: var(--ink);">Por Dra. Mariana Rossi · {site.role} · {site.crm} · {site.rqe}</span>
        <span>{minutes} min de leitura</span>
        <span>{d.updated ? `Atualizado em ${formatDate(d.updated)}` : `Publicado em ${formatDate(d.date)}`}</span>
      </div>
    </div>
  </header>
  <article class="article">
    {d.summary.length > 0 && (
      <aside class="a-summary" aria-label="Resumo">
        <p class="kicker">Resumo da Tia Mari</p>
        <ul>{d.summary.map((s) => <li>{s}</li>)}</ul>
      </aside>
    )}

    <div class="prose">
      <Content />
    </div>

    {d.alerts.length > 0 && (
      <section class="a-alert" aria-labelledby="alerta-t">
        <span class="sem-light" aria-hidden="true"></span>
        <h2 id="alerta-t">{d.alertsTitle}</h2>
        <ul>{d.alerts.map((s) => <li>{s}</li>)}</ul>
        <p>Em emergência, ligue 192 (SAMU).</p>
      </section>
    )}

    <div class="a-share">
      <a class="btn btn-white btn-sm" href={whatsapp} target="_blank" rel="noopener" data-event="whatsapp_share">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/></svg>
        Enviar pelo WhatsApp
      </a>
    </div>

    <div class="a-refs">
      {d.references.length > 0 && (
        <>
          <p style="font-weight: 600; color: var(--ink);">Referências</p>
          <ol>
            {d.references.map((r) => <li>{r.url ? <a href={r.url} rel="noopener" target="_blank">{r.label}</a> : r.label}</li>)}
          </ol>
        </>
      )}
      <p>Este conteúdo é informativo e não substitui uma consulta médica.</p>
    </div>

    <div class="a-author">
      <Image src={avatar} alt="" width={152} height={152} class="a-avatar" />
      <div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 4px;">
        <span style="font-weight: 800;">Dra. {site.fullName} · {site.role} · {site.crm} · {site.rqe}</span>
        <span style="font-size: 16px; color: var(--muted); line-height: 1.5;">A Tia Mari: pediatra com Título de Especialista pela SBP, atua em pronto atendimento em Ribeirão Preto e escreve para explicar com calma o que ouve todos os dias.</span>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="wrap" aria-labelledby="mais-t" style="padding-top: 48px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 24px;">
      <h2 id="mais-t" style="font-size: 28px;">Continue lendo</h2>
      <div class="grid-cards">{others.map((a) => <ArticleCard entry={a} />)}</div>
    </section>
  )}

  <Newsletter title="Quer a próxima dica no seu e-mail?" text="Uma dica nova por vez, sem alarmismo e sem spam." />
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const art = document.querySelector<HTMLElement>('.article');
  if (bar && art) {
    const update = () => {
      const r = art.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 5px; z-index: 50; }
  .progress span { display: block; height: 100%; background: var(--morango); transform-origin: 0 50%; transform: scaleX(0); border-radius: 0 6px 6px 0; }
  .a-head { background: var(--l); border-bottom: 3px solid var(--c); }
  .a-head-inner { max-width: 800px; margin: 0 auto; padding: 48px 24px 36px; display: flex; flex-direction: column; gap: 16px; }
  .a-head .tag { background: #fff; }
  .crumbs { font-size: 15px; font-weight: 700; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .a-title { font-size: clamp(2.2rem, 4.4vw, 3.6rem); line-height: 1.05; font-weight: 700; view-transition-name: article-title; }
  .a-lead { font-size: 21px; color: var(--ink); line-height: 1.5; font-weight: 600; }
  .a-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 15px; font-weight: 700; color: var(--muted); }
  .article { max-width: 800px; margin: 0 auto; padding: 40px 24px 32px; display: flex; flex-direction: column; gap: 24px; font-size: 19px; line-height: 1.75; }
  .a-summary { background: var(--sol-l); border: 3px solid var(--sol); border-radius: 26px; padding: 24px 28px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 5px 0 var(--sol); }
  .a-summary .kicker { color: #8A5A00; }
  .a-summary ul, .a-alert ul { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 6px; font-weight: 700; }
  .prose :global(h2) { font-size: 31px; line-height: 1.18; margin: 40px 0 12px; }
  .prose :global(h3) { font-size: 24px; line-height: 1.25; margin: 28px 0 10px; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; padding-left: 24px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(li::marker) { color: var(--morango); font-weight: 800; }
  .prose :global(strong) { color: var(--ink); background: linear-gradient(transparent 60%, var(--sol-l) 60%); }
  .prose :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; margin: 8px 0 24px; font-size: 17px; border: 2px solid var(--line); border-radius: 18px; overflow: hidden; }
  .prose :global(th) { background: var(--sol-l); text-align: left; padding: 12px 16px; font-family: var(--display); font-weight: 600; }
  .prose :global(td) { padding: 12px 16px; border-top: 2px solid var(--line); vertical-align: top; }
  .prose :global(blockquote) { margin: 24px 0; padding: 18px 22px; border-radius: 20px; background: var(--ceu-l); color: var(--ink); }
  .a-alert { background: var(--morango-l); border: 3px solid var(--morango); color: var(--ink); border-radius: 28px; padding: 28px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 6px 0 var(--morango); }
  .a-alert .sem-light { width: 38px; height: 38px; border-radius: 50%; background: var(--morango); box-shadow: 0 0 0 7px #fff; }
  .a-alert h2 { font-size: 27px; line-height: 1.2; color: var(--morango-d); }
  .a-alert p { font-size: 16px; font-weight: 800; color: var(--morango-d); }
  .a-share { display: flex; }
  .a-refs { padding-top: 20px; border-top: 2px solid var(--line); font-size: 15px; color: var(--muted); display: flex; flex-direction: column; gap: 8px; font-weight: 600; }
  .a-refs ol { margin: 0; padding-left: 20px; }
  .a-author { background: var(--uva-l); border-radius: 26px; padding: 22px 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  .a-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 4px solid #fff; }
</style>
