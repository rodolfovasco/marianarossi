---
import GameShell from '../../components/GameShell.astro';
---
<GameShell title="Escove os dentes do Bento" color="t-menta" intro="Xi, o Bento comeu doce e esqueceu de escovar! Toque nos bichinhos para deixar os dentes dele brilhando." description="Jogo de escovar os dentes do Bento: toque nos bichinhos para limpar os dentes.">
  <div class="score" aria-live="polite">
    <span class="pill">Bichinhos: <b data-left>0</b></span>
    <span class="pill">Rodada: <b data-round>1</b></span>
  </div>
  <p class="status" data-status role="status">Toque nos bichinhos verdes!</p>
  <div class="mouth-wrap">
    <svg class="mouth" viewBox="0 0 400 260" aria-hidden="true">
      <path d="M20 70 Q200 -20 380 70 Q370 230 200 250 Q30 230 20 70 Z" fill="#B8344F" stroke="#3B2F45" stroke-width="6" />
      <path d="M90 200 Q200 260 310 200 Q260 240 200 242 Q140 240 90 200 Z" fill="#FF8FAB" />
      <g class="teeth-top">
        <rect x="52" y="44" width="52" height="64" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="110" y="34" width="56" height="72" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="172" y="30" width="56" height="76" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="234" y="34" width="56" height="72" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="296" y="44" width="52" height="64" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
      </g>
      <g class="teeth-bottom">
        <rect x="78" y="150" width="54" height="56" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="138" y="156" width="58" height="60" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="204" y="156" width="58" height="60" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
        <rect x="268" y="150" width="54" height="56" rx="16" fill="#fff" stroke="#3B2F45" stroke-width="4" />
      </g>
      <g class="shine" data-shine>
        <path d="M120 20 l6 14 l14 6 l-14 6 l-6 14 l-6 -14 l-14 -6 l14 -6 z" fill="#FFC845" />
        <path d="M300 130 l5 11 l11 5 l-11 5 l-5 11 l-5 -11 l-11 -5 l11 -5 z" fill="#FFC845" />
        <path d="M200 120 l4 9 l9 4 l-9 4 l-4 9 l-4 -9 l-9 -4 l9 -4 z" fill="#FFC845" />
      </g>
    </svg>
    <div class="germs" data-germs></div>
  </div>
  <button type="button" class="btn" data-restart>Próxima rodada</button>
  <p class="tip"><b>Dica da Tia Mari:</b> escovar os dentes depois das refeições e antes de dormir ajuda a afastar as cáries. Nos pequenos, quem escova é um adulto.</p>
</GameShell>

<script>
  // Posições (em % da área da boca) onde os bichinhos podem aparecer: em cima dos dentes.
  const spots = [[19,28],[34,24],[50,22],[65,24],[81,28],[26,68],[42,71],[58,71],[74,68],[27,38],[50,34],[73,38],[35,62],[66,62]];
  const box = document.querySelector<HTMLElement>('[data-germs]')!;
  const leftEl = document.querySelector('[data-left]')!;
  const roundEl = document.querySelector('[data-round]')!;
  const status = document.querySelector('[data-status]')!;
  const shine = document.querySelector('[data-shine]')!;
  let left = 0, round = 1;

  function germSvg() {
    return '<svg viewBox="0 0 60 60" aria-hidden="true"><path d="M30 6 C 40 6, 46 12, 48 18 C 56 20, 58 30, 52 36 C 56 44, 50 54, 40 52 C 36 58, 24 58, 20 52 C 10 54, 4 44, 8 36 C 2 30, 4 20, 12 18 C 14 12, 20 6, 30 6 Z" fill="#7BD389" stroke="#3B2F45" stroke-width="3"/><circle cx="23" cy="28" r="5" fill="#fff"/><circle cx="37" cy="28" r="5" fill="#fff"/><circle cx="24" cy="29" r="2.4" fill="#3B2F45"/><circle cx="36" cy="29" r="2.4" fill="#3B2F45"/><path d="M23 40 Q30 36 37 40" stroke="#3B2F45" stroke-width="3" fill="none" stroke-linecap="round"/></svg>';
  }

  function start() {
    box.innerHTML = ''; shine.classList.remove('on');
    const n = Math.min(4 + round * 2, spots.length);
    const pick = [...spots].sort(() => Math.random() - 0.5).slice(0, n);
    left = n; leftEl.textContent = String(left); roundEl.textContent = String(round);
    status.textContent = 'Toque nos bichinhos verdes!';
    pick.forEach(([x, y], i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'germ'; b.setAttribute('aria-label', 'Bichinho da cárie');
      b.style.left = `${x}%`; b.style.top = `${y}%`; b.style.setProperty('--d', `${i * 70}ms`);
      b.innerHTML = germSvg();
      b.addEventListener('click', () => clean(b));
      box.appendChild(b);
    });
  }

  function clean(b: HTMLButtonElement) {
    if (b.classList.contains('gone')) return;
    b.classList.add('gone');
    const foam = document.createElement('span'); foam.className = 'foam';
    foam.style.left = b.style.left; foam.style.top = b.style.top;
    box.appendChild(foam);
    setTimeout(() => { b.remove(); foam.remove(); }, 600);
    left--; leftEl.textContent = String(left);
    if (left === 0) {
      shine.classList.add('on');
      status.textContent = 'Dentinhos brilhando! O Bento agradece.';
      round++;
    } else {
      status.textContent = ['Isso!', 'Muito bem!', 'Tchau, bichinho!', 'Brilhou!'][Math.floor(Math.random() * 4)];
    }
  }

  document.querySelector('[data-restart]')!.addEventListener('click', start);
  start();
</script>

<style>
  .score { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .pill { background: #fff; border: 2px solid var(--line); border-radius: 999px; padding: 6px 16px; font-weight: 800; }
  .status { font-family: var(--display); font-weight: 600; font-size: 24px; text-align: center; min-height: 1.4em; }
  .mouth-wrap { position: relative; width: min(560px, 100%); }
  .mouth { width: 100%; height: auto; overflow: visible; }
  .germs { position: absolute; inset: 0; }
  .germs :global(.germ) { position: absolute; width: 15%; aspect-ratio: 1; transform: translate(-50%, -50%); background: none; border: 0; padding: 0; cursor: pointer; }
  .germs :global(.germ svg) { width: 100%; height: 100%; }
  .germs :global(.germ.gone) { pointer-events: none; animation: bye .4s ease-in forwards; }
  .germs :global(.foam) { position: absolute; width: 18%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle at 30% 30%, #fff 0 20%, transparent 21%), radial-gradient(circle at 70% 40%, #fff 0 16%, transparent 17%), radial-gradient(circle at 45% 70%, #fff 0 18%, transparent 19%); animation: foam .6s ease-out forwards; pointer-events: none; }
  .shine { opacity: 0; transition: opacity .3s; }
  .shine.on { opacity: 1; }
  .tip { max-width: 560px; text-align: center; font-weight: 700; color: var(--ink); background: #fff; border-radius: 20px; padding: 14px 20px; border: 2px solid var(--line); }
  @keyframes bye { to { transform: translate(-50%, -50%) scale(0) rotate(90deg); opacity: 0; } }
  @keyframes foam { from { transform: translate(-50%, -50%) scale(.4); opacity: 1; } to { transform: translate(-50%, -50%) scale(1.4); opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .germs :global(.germ) { animation: spring-in .5s var(--spring) both, wobble 1.6s ease-in-out infinite; animation-delay: var(--d), calc(var(--d) + .5s); }
    .shine.on path { transform-box: fill-box; transform-origin: center; animation: twinkle 1s var(--spring) infinite alternate; }
    @keyframes wobble { 0%, 100% { rotate: -6deg; } 50% { rotate: 6deg; } }
    @keyframes twinkle { from { transform: scale(.7); } to { transform: scale(1.2); } }
  }
</style>
