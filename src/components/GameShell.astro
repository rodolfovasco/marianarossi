---
import Base from '../layouts/Base.astro';
import Bento from './Bento.astro';
import { url } from '../lib/site';
interface Props { title: string; intro: string; color: string; description: string }
const { title, intro, color, description } = Astro.props;
---
<Base title={`${title} · Brinque com o Bento`} description={description}>
  <section class={`game-page ${color}`}>
    <div class="wrap game-head">
      <a class="back" href={url('/#brincar')}>← Voltar para os jogos</a>
      <div class="game-title">
        <Bento size={96} />
        <div>
          <p class="kicker">Brinque com o Bento</p>
          <h1>{title}</h1>
          <p class="intro">{intro}</p>
        </div>
      </div>
    </div>
    <div class="wrap game-body">
      <slot />
    </div>
    <div class="wrap game-foot">
      <p>Brincar junto também é cuidado. Que tal jogar com a criança e conversar enquanto isso?</p>
      <a class="btn btn-white btn-sm" href={url('/#brincar')}>Ver outros jogos</a>
    </div>
  </section>
</Base>

<style>
  .game-page { background: var(--l); min-height: 70vh; }
  .game-head { padding-top: 32px; padding-bottom: 8px; display: flex; flex-direction: column; gap: 18px; }
  .back { font-weight: 800; color: var(--ink); text-decoration: none; align-self: flex-start; padding: 8px 0; }
  .back:hover { color: var(--c); }
  .game-title { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .game-title h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.05; font-weight: 700; }
  .game-title .kicker { color: var(--c); }
  .intro { font-size: 19px; font-weight: 700; color: var(--muted); }
  .game-body { padding-top: 24px; padding-bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .game-foot { padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px 20px; text-align: center; font-weight: 700; color: var(--muted); }
</style>
