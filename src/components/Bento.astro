---
// Bento, o ursinho da Tia Mari. Original, desenhado em SVG.
interface Props { size?: number; wave?: boolean; still?: boolean; class?: string; holding?: 'heart' | 'letter' }
const { size = 200, wave = true, still = false, class: cls = '', holding = 'heart' } = Astro.props;
const LINE = '#5A2A12';
const FUR = '#E07A35';
const FUR_D = '#C8622A';
const LIGHT = '#F7D4B6';
const PINK = '#F4A3B4';
const EYE = '#4A1F0E';
const SW = 4;
---
<svg class={`bento ${wave ? 'bento-wave' : ''} ${still ? 'bento-still' : ''} ${cls}`} width={size} height={size * 1.1} viewBox="0 0 200 220" role="img" aria-label="Bento, o ursinho mascote da Tia Mari, dando uma piscadinha">
  <g class="bento-body">
    <!-- patas de trás, abertas para o lado -->
    <ellipse cx="40" cy="192" rx="30" ry="22" fill={FUR_D} stroke={LINE} stroke-width={SW} />
    <ellipse cx="32" cy="198" rx="11" ry="10" fill={LIGHT} />
    <circle cx="20" cy="186" r="4.2" fill={LIGHT} /><circle cx="27" cy="180" r="4.2" fill={LIGHT} /><circle cx="36" cy="179" r="4.2" fill={LIGHT} />
    <ellipse cx="160" cy="192" rx="30" ry="22" fill={FUR_D} stroke={LINE} stroke-width={SW} />
    <ellipse cx="168" cy="198" rx="11" ry="10" fill={LIGHT} />
    <circle cx="180" cy="186" r="4.2" fill={LIGHT} /><circle cx="173" cy="180" r="4.2" fill={LIGHT} /><circle cx="164" cy="179" r="4.2" fill={LIGHT} />

    <!-- corpo -->
    <path d="M62 138 C 52 166, 54 196, 66 208 L 134 208 C 146 196, 148 166, 138 138 Z" fill={FUR} stroke={LINE} stroke-width={SW} stroke-linejoin="round" />
    <path d="M100 150 C 92 162, 92 196, 100 206 C 108 196, 108 162, 100 150 Z" fill={LIGHT} />

    <!-- pata da frente esquerda -->
    <path d="M68 148 C 64 172, 62 196, 64 205 C 68 214, 88 214, 91 205 C 92 190, 90 168, 88 148 Z" fill={FUR} stroke={LINE} stroke-width={SW} stroke-linejoin="round" />
    <path d="M72 206 v4 M80 207 v4" stroke={LINE} stroke-width="2.6" stroke-linecap="round" />

    <!-- pata da frente direita (acena) -->
    <g class="bento-arm">
      <path d="M132 148 C 136 172, 138 196, 136 205 C 132 214, 112 214, 109 205 C 108 190, 110 168, 112 148 Z" fill={FUR} stroke={LINE} stroke-width={SW} stroke-linejoin="round" />
      <path d="M120 207 v4 M128 206 v4" stroke={LINE} stroke-width="2.6" stroke-linecap="round" />
    </g>

    <!-- item -->
    {holding === 'heart' ? (
      <path d="M100 178 C 91 172, 89 164, 94 161 C 97 159.5, 99 162, 100 164 C 101 162, 103 159.5, 106 161 C 111 164, 109 172, 100 178 Z" fill="#D63A63" stroke={LINE} stroke-width="2.6" stroke-linejoin="round" />
    ) : (
      <g transform="rotate(-6 100 176)">
        <rect x="80" y="162" width="40" height="28" rx="6" fill="#fff" stroke={LINE} stroke-width="3" />
        <path d="M82 165 L100 178 L118 165" fill="none" stroke={LINE} stroke-width="3" stroke-linejoin="round" />
        <circle cx="100" cy="181" r="3.5" fill="#D63A63" />
      </g>
    )}

    <!-- orelhas -->
    <circle cx="50" cy="46" r="22" fill={FUR} stroke={LINE} stroke-width={SW} />
    <circle cx="53" cy="50" r="12" fill={PINK} />
    <circle cx="152" cy="40" r="22" fill={FUR} stroke={LINE} stroke-width={SW} />
    <circle cx="149" cy="44" r="12" fill={PINK} />

    <!-- cabeça -->
    <path d="M34 98 C 30 58, 60 30, 100 30 C 142 30, 172 56, 166 98 C 162 134, 134 152, 100 152 C 64 152, 38 134, 34 98 Z" fill={FUR} stroke={LINE} stroke-width={SW} stroke-linejoin="round" />
    <!-- topetinho -->
    <path d="M88 34 C 86 22, 94 14, 104 16 C 99 21, 101 27, 108 26 C 113 24, 118 27, 116 33" fill={FUR} stroke={LINE} stroke-width={SW} stroke-linejoin="round" stroke-linecap="round" />
    <!-- sombrinha embaixo da cabeça -->
    <path d="M52 128 C 66 144, 134 144, 148 128 C 140 146, 120 150, 100 150 C 80 150, 60 146, 52 128 Z" fill={FUR_D} opacity="0.55" />

    <!-- olho aberto -->
    <g class="bento-eyes">
      <ellipse cx="72" cy="98" rx="13.5" ry="15.5" fill={EYE} />
      <circle cx="76.5" cy="92" r="5.2" fill="#fff" />
      <circle cx="67.5" cy="104.5" r="2.2" fill="#fff" />
    </g>
    <!-- piscadinha -->
    <path d="M116 98 Q 128 86 141 95" fill="none" stroke={LINE} stroke-width="4.5" stroke-linecap="round" />
    <path d="M139 93 L 146 89" stroke={LINE} stroke-width="3.5" stroke-linecap="round" />
    <!-- bochechas -->
    <ellipse cx="54" cy="122" rx="9" ry="6" fill={PINK} opacity="0.7" />
    <ellipse cx="148" cy="118" rx="9" ry="6" fill={PINK} opacity="0.7" />

    <!-- focinho com boca aberta -->
    <circle cx="102" cy="120" r="21" fill={LIGHT} />
    <path d="M95 106 Q 102 103 109 106 Q 108 113 102 115 Q 96 113 95 106 Z" fill={EYE} />
    <path d="M102 115 V 119" stroke={EYE} stroke-width="2.6" stroke-linecap="round" />
    <path d="M89 120 Q 102 117 115 120 Q 112 136 102 136 Q 92 136 89 120 Z" fill="#6B2410" stroke={EYE} stroke-width="2.4" stroke-linejoin="round" />
    <path d="M95 131 Q 102 125 109 131 Q 106 136 102 136 Q 98 136 95 131 Z" fill="#F27F95" />

    <!-- curativo (marca do Bento) -->
    <g transform="rotate(-30 64 66)">
      <rect x="51" y="61" width="26" height="10" rx="5" fill="#FFE1BF" stroke={LINE} stroke-width="2.2" />
      <rect x="60" y="61" width="8" height="10" fill="#FFF0DC" stroke={LINE} stroke-width="2.2" />
    </g>
  </g>
</svg>

<style>
  .bento { overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .bento-eyes { transform-origin: 72px 98px; animation: blink 4.2s infinite; }
    .bento-wave .bento-arm { transform-origin: 120px 150px; animation: wave 2.6s var(--spring) 0.8s 2; }
    .bento:hover .bento-arm { transform-origin: 120px 150px; animation: wave 1.6s var(--spring) 1; }
    .bento-body { transform-origin: 100px 220px; animation: breathe 3.6s ease-in-out infinite; }
    .bento-still .bento-body, .bento-still .bento-arm, .bento-still:hover .bento-arm { animation: none; }
  }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes wave { 0%, 100% { transform: rotate(0); } 18% { transform: rotate(-125deg); } 34% { transform: rotate(-100deg); } 50% { transform: rotate(-128deg); } 66% { transform: rotate(-102deg); } 82% { transform: rotate(-120deg); } }
  @keyframes breathe { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.012, 0.988); } }
</style>
