---
import { site, url } from '../lib/site';
import Bento from './Bento.astro';
import Sticker from './Sticker.astro';
interface Props { title?: string; text?: string; id?: string }
const {
  title = 'Receba as Dicas da Tia Mari',
  text = 'Uma dica nova por vez, direto no seu e-mail. Sem alarmismo e sem spam.',
  id = 'receber',
} = Astro.props;
---
<section id={id} aria-labelledby={`${id}-t`} class="nl" data-loop>
  <Sticker kind="star" size={54} class="float nl-s1" style="--rot: -12deg; --dur: 5s" />
  <Sticker kind="heart" size={46} class="float nl-s2" style="--rot: 10deg; --dur: 6s; --fd: -2s" />
  <div class="wrap nl-inner">
    <div class="nl-copy pop">
      <Bento size={150} holding="letter" class="nl-bento" />
      <h2 id={`${id}-t`} style="font-size: clamp(2.2rem, 3.8vw, 3.3rem); line-height: 1.05;">{title}</h2>
      <p style="font-size: 19px; color: #fff; font-weight: 600;">{text}</p>
    </div>
    <form class="form nl-form pop" style="--delay: .1s" data-newsletter action={site.newsletterAction || undefined} method="post">
      <div class="form-row">
        <label class="field">Seu nome
          <input type="text" name="nome" autocomplete="given-name" placeholder="Como posso te chamar?" />
        </label>
        <label class="field" style="flex-grow: 1.4;">Seu e-mail
          <input type="email" name="email" autocomplete="email" placeholder="voce@email.com" required />
        </label>
      </div>
      <label class="field">
        <span>Qual dúvida você quer que eu explique? <span style="font-weight: 600; opacity: .85;">(opcional)</span></span>
        <input type="text" name="tema" placeholder="Ex.: quando dar o primeiro banho de mar" />
      </label>
      <button type="submit" class="btn btn-sun" style="align-self: flex-start;">Quero receber as dicas</button>
      <p class="form-status" data-status role="status" aria-live="polite"></p>
      <p style="font-size: 15px; color: #fff;">Você cancela com um clique quando quiser. Seus dados seguem a <a href={url('/privacidade/')} style="color: #fff; font-weight: 800;">Política de Privacidade</a>.</p>
    </form>
  </div>
</section>

<style>
  .nl { position: relative; overflow: hidden; background: var(--morango); color: #fff; }
  .nl-inner { position: relative; padding-top: 88px; padding-bottom: 80px; display: flex; flex-wrap: wrap; gap: 40px 56px; align-items: center; }
  .nl-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .nl-form { flex: 1 1 420px; min-width: 0; background: rgba(0,0,0,0.12); border-radius: 28px; padding: 28px; }
  .nl :global(.nl-s1) { position: absolute; top: 34px; right: 7%; }
  .nl :global(.nl-s2) { position: absolute; bottom: 36px; left: 4%; }
  @media (max-width: 700px) { .nl :global(.nl-s1), .nl :global(.nl-s2) { display: none; } }
</style>
